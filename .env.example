OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-2.5-pro-preview   # optional, this is the default

# ── Healthcare Shift Staffing (Metabase) ─────────────────────────────────────
# Required to source professionals from the Livo repeaters database
METABASE_URL=https://livo.metabaseapp.com        # your Metabase instance URL
METABASE_USERNAME=your@email.com                 # Metabase login email
METABASE_PASSWORD=yourpassword                   # Metabase login password
# OR use API key (Metabase 47+) — takes priority over username/password:
METABASE_API_KEY=mb_...                          # Settings → API Keys in Metabase

# ── Search APIs (AI talent recruiting) ───────────────────────────────────────
BRAVE_API_KEY=BSA...                             # https://brave.com/search/api/ — needs credit card
TAVILY_API_KEY=tvly-...                          # https://tavily.com — FREE tier, email only, no card ✓

GITHUB_TOKEN=ghp_...                             # optional — raises rate limit from 60 to 5000 req/hr
HUNTER_API_KEY=...                               # optional — enables email discovery via hunter.io
PROXYCURL_API_KEY=...                            # optional — enriches LinkedIn profiles (~$0.01/profile)
SEMANTIC_SCHOLAR_API_KEY=...                     # optional — higher rate limits on Semantic Scholar
